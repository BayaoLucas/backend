{
  "name": "ms2-vestuario-sprint2",
  "version": "1.0.0",
  "private": true,
  "description": "Backend MS² Vestuário com rotas, autenticação e venda transacional",
  "type": "commonjs",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
