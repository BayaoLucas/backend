    "check:db": "tsx src/scripts/verificarBanco.ts",
    "setup:gerente": "tsx src/scripts/criarGerente.ts",
    "test": "npm run build && node --test tests/*.test.cjs"
  },
  "dependencies": {
    "@types/axios": "^0.9.36",
    "axios": "^1.20.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.24.6"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
